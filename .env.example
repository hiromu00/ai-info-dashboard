# ===========================================
# AI Info Dashboard 環境変数設定
# ===========================================
# このファイルをコピーして .env を作成してください
#   cp .env.example .env
#
# 必須項目を設定してから docker-compose up してください

# --- GCP / Vertex AI 設定（必須） ---
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-flash

# --- 実行モード（オプション） ---
# "oneshot" or "daemon"（デフォルト: oneshot）
# RUN_MODE=daemon

# --- スケジュール間隔（時間単位、デフォルト: 6） ---
# SCHEDULE_INTERVAL_HOURS=6

# --- RSS最大取得件数（デフォルト: 5） ---
# RSS_MAX_ENTRIES=5
