# ===========================================
# AI Info Dashboard 環境変数設定
# ===========================================
# このファイルをコピーして .env を作成してください
#   cp .env.example .env
#
# 必須項目を設定してから docker-compose up してください

# --- Google AI Studio 設定（必須） ---
# https://aistudio.google.com/app/apikey から取得したAPIキー
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- 実行モード（オプション） ---
# "oneshot" or "daemon"（デフォルト: oneshot）
# RUN_MODE=daemon

# --- スケジュール間隔（時間単位、デフォルト: 6） ---
# SCHEDULE_INTERVAL_HOURS=6

# --- RSS最大取得件数（デフォルト: 5） ---
# RSS_MAX_ENTRIES=5
